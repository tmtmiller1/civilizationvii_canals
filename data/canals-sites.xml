<?xml version="1.0" encoding="utf-8"?>
<!--
  Canal sites. The Canal requires the site marker on its tile, so the engine offers it, to the game's own AI as to the
  player, only on a tile ui/canals.js has marked. The canal rule itself (a strip of land between two shores, the chain
  rules of each age) lives in the script because the engine's data cannot express it, and the game's AI obeys only
  the data. Without the marker the AI never weighs the building at all.
  The marker has no feature class, since a class shifts the owner's flat-tile bonus. It gives way to other buildings
  (Removable) and yields what bare land yields (data/canals-sites.sql). No map places it (PlacementDensity 0).
  An opened canal is coast with its Canal building still on it, and the building requires the marker, so the marker
  is valid on coast as well and yields what bare coast does.
  The one-tile Canal has a marker of its own, FEATURE_CANALS_SITE_ONE_TILE, placed only in the one-tile mode. The
  engine offers each kind of Canal only where its own marker stands, so the AI builds the Canal of the mode in play.
-->
<Database>
    <Types>
        <Row Type="FEATURE_CANALS_SITE" Kind="KIND_FEATURE"/>
        <Row Type="FEATURE_CANALS_SITE_ONE_TILE" Kind="KIND_FEATURE"/>
    </Types>
    <Features>
        <Row FeatureType="FEATURE_CANALS_SITE" Name="LOC_FEATURE_CANALS_SITE_NAME" Tooltip="LOC_FEATURE_CANALS_SITE_TOOLTIP" PlacementClass="ONE" PlacementDensity="0" Removable="true"/>
        <Row FeatureType="FEATURE_CANALS_SITE_ONE_TILE" Name="LOC_FEATURE_CANALS_SITE_NAME" Tooltip="LOC_FEATURE_CANALS_SITE_TOOLTIP" PlacementClass="ONE" PlacementDensity="0" Removable="true"/>
    </Features>
    <Feature_ValidTerrains>
        <Row FeatureType="FEATURE_CANALS_SITE" TerrainType="TERRAIN_FLAT"/>
        <Row FeatureType="FEATURE_CANALS_SITE" TerrainType="TERRAIN_HILL"/>
        <Row FeatureType="FEATURE_CANALS_SITE" TerrainType="TERRAIN_COAST"/>
        <Row FeatureType="FEATURE_CANALS_SITE_ONE_TILE" TerrainType="TERRAIN_FLAT"/>
        <Row FeatureType="FEATURE_CANALS_SITE_ONE_TILE" TerrainType="TERRAIN_HILL"/>
        <Row FeatureType="FEATURE_CANALS_SITE_ONE_TILE" TerrainType="TERRAIN_COAST"/>
    </Feature_ValidTerrains>
    <Feature_ValidBiomes>
        <Row BiomeType="BIOME_MARINE" FeatureType="FEATURE_CANALS_SITE"/>
        <Row BiomeType="BIOME_DESERT" FeatureType="FEATURE_CANALS_SITE"/>
        <Row BiomeType="BIOME_GRASSLAND" FeatureType="FEATURE_CANALS_SITE"/>
        <Row BiomeType="BIOME_PLAINS" FeatureType="FEATURE_CANALS_SITE"/>
        <Row BiomeType="BIOME_TROPICAL" FeatureType="FEATURE_CANALS_SITE"/>
        <Row BiomeType="BIOME_TUNDRA" FeatureType="FEATURE_CANALS_SITE"/>
        <Row BiomeType="BIOME_MARINE" FeatureType="FEATURE_CANALS_SITE_ONE_TILE"/>
        <Row BiomeType="BIOME_DESERT" FeatureType="FEATURE_CANALS_SITE_ONE_TILE"/>
        <Row BiomeType="BIOME_GRASSLAND" FeatureType="FEATURE_CANALS_SITE_ONE_TILE"/>
        <Row BiomeType="BIOME_PLAINS" FeatureType="FEATURE_CANALS_SITE_ONE_TILE"/>
        <Row BiomeType="BIOME_TROPICAL" FeatureType="FEATURE_CANALS_SITE_ONE_TILE"/>
        <Row BiomeType="BIOME_TUNDRA" FeatureType="FEATURE_CANALS_SITE_ONE_TILE"/>
    </Feature_ValidBiomes>
    <Constructible_RequiredFeatures>
        <Row ConstructibleType="BUILDING_CANAL_ANTIQUITY" FeatureType="FEATURE_CANALS_SITE"/>
        <Row ConstructibleType="BUILDING_CANAL_EXPLORATION" FeatureType="FEATURE_CANALS_SITE"/>
        <Row ConstructibleType="BUILDING_CANAL_MODERN" FeatureType="FEATURE_CANALS_SITE"/>
        <Row ConstructibleType="BUILDING_CANAL_ONE_TILE" FeatureType="FEATURE_CANALS_SITE_ONE_TILE"/>
    </Constructible_RequiredFeatures>
</Database>
