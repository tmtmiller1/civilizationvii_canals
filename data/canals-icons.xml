        <Row><ID>BUILDING_CANAL_ANTIQUITY</ID><Path>fs://game/tower-canals/icons/building_canal_ancient_256.png</Path></Row>
        <Row><ID>BUILDING_CANAL_ANTIQUITY</ID><IconSize>128</IconSize><Path>fs://game/tower-canals/icons/building_canal_ancient_128.png</Path></Row>
        <Row><ID>BUILDING_CANAL_ANTIQUITY</ID><IconSize>64</IconSize><Path>fs://game/tower-canals/icons/building_canal_ancient_64.png</Path></Row>
        <Row><ID>BUILDING_CANAL_EXPLORATION</ID><Path>fs://game/tower-canals/icons/building_canal_medieval_256.png</Path></Row>
        <Row><ID>BUILDING_CANAL_EXPLORATION</ID><IconSize>128</IconSize><Path>fs://game/tower-canals/icons/building_canal_medieval_128.png</Path></Row>
        <Row><ID>BUILDING_CANAL_EXPLORATION</ID><IconSize>64</IconSize><Path>fs://game/tower-canals/icons/building_canal_medieval_64.png</Path></Row>
        <Row><ID>BUILDING_CANAL_MODERN</ID><Path>fs://game/tower-canals/icons/building_canal_modern_256.png</Path></Row>
